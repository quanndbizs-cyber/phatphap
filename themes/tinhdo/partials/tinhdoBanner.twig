{# Sacred Lotus Header & Pure Land Plaque Bar #}
<div class="tinhdo-top-bar">
	<div class="tinhdo-top-bar-inner">
		<div class="tinhdo-top-brand">
			<span class="tinhdo-lotus-icon" aria-hidden="true">
				<svg viewBox="0 0 64 44" width="30" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M32 4C28 12 25 20 32 34C39 20 36 12 32 4Z" fill="#f5d061" stroke="#d4af37" stroke-width="1.5"/>
					<path d="M32 34C22 28 17 18 20 9C26 14 29 22 32 34Z" fill="#f2b8c6" stroke="#d4af37" stroke-width="1.3"/>
					<path d="M32 34C42 28 47 18 44 9C38 14 35 22 32 34Z" fill="#f2b8c6" stroke="#d4af37" stroke-width="1.3"/>
					<path d="M32 35C18 33 9 25 8 16C17 18 24 25 32 35Z" fill="#e598ad" stroke="#d4af37" stroke-width="1.2"/>
					<path d="M32 35C46 33 55 25 56 16C47 18 40 25 32 35Z" fill="#e598ad" stroke="#d4af37" stroke-width="1.2"/>
					<path d="M12 36C24 39 40 39 52 36" stroke="#d4af37" stroke-width="2" stroke-linecap="round"/>
				</svg>
			</span>
			<a href="{{ home_url }}" class="tinhdo-top-title">{{ settings.title|default('Thư Viện Phật Pháp & Tịnh Độ Liên Hoa') }}</a>
		</div>
		<div class="tinhdo-top-mantra">
			<button type="button" class="tinhdo-search-btn" id="tm-search-trigger" aria-label="Tìm kiếm bài viết">
				<span class="tinhdo-search-icon">🔍</span>
				<span class="tinhdo-search-placeholder">Tìm kiếm kinh, truyện, bài giảng...</span>
				<kbd class="tinhdo-search-kbd">Ctrl K</kbd>
			</button>
			<div class="tinhdo-font-controller" title="Tùy chỉnh đọc kinh & sách">
				{# 1 Button A+ chu kỳ tăng & reset #}
				<button type="button" class="tinhdo-font-btn tm-font-cycle-btn" id="tm-font-cycle-top" title="Tăng cỡ chữ (A+) — bấm để tăng, chạm mốc tối đa sẽ quay về 100%" aria-label="Tăng cỡ chữ">
					<span class="tm-font-cycle-label">A+</span>
					<span class="tm-font-scale-badge tm-font-scale-text">100%</span>
				</button>
				{# Chế độ đọc ban đêm (icon mặt trăng khuyết) #}
				<button type="button" class="tinhdo-font-btn tm-night-mode-btn" id="tm-night-mode-top" title="Chế độ đọc ban đêm (dịu mắt, chống chói)" aria-label="Chế độ đọc ban đêm">
					<span class="tm-night-icon" aria-hidden="true">🌙</span>
				</button>
				{% if theme.elderlyModeSupport %}
				{# Chế độ Chữ Lớn Toàn Diện cho Người Cao Tuổi #}
				<button type="button" class="tinhdo-font-btn tm-elderly-mode-btn" id="tm-elderly-mode-top" title="Bật/Tắt chế độ Chữ Lớn & Nút Bấm To Toàn Diện cho Người Cao Tuổi" aria-label="Chế độ chữ lớn người cao tuổi">
					<span class="tm-elderly-icon" aria-hidden="true">👓</span>
					<span class="tm-elderly-text">Chữ lớn</span>
				</button>
				{% endif %}
			</div>
			<span class="mantra-badge">☸ Nam Mô A Di Đà Phật</span>
			<div class="tinhdo-top-dropdown" id="tm-top-dropdown">
				<button type="button" class="tinhdo-top-dropdown-btn" id="tm-top-dropdown-btn" aria-haspopup="true" aria-expanded="false">
					<span class="tinhdo-dropdown-icon" aria-hidden="true">🪷</span>
					<span class="tinhdo-dropdown-label">Danh mục chính</span>
					<span class="tinhdo-dropdown-caret" aria-hidden="true">▾</span>
				</button>
				<div class="tinhdo-top-dropdown-menu" id="tm-top-dropdown-menu" role="menu" aria-label="Danh mục chính">
					<a href="{{ base_url }}/phat-giao/cac-bai-khai-thi" class="tinhdo-top-dropdown-item" role="menuitem">
						<span class="tinhdo-dd-num">1.</span>
						<span class="tinhdo-dd-text">Các bài khai thị</span>
					</a>
					<a href="{{ base_url }}/phat-giao/khuyen-nguoi-niem-phat" class="tinhdo-top-dropdown-item" role="menuitem">
						<span class="tinhdo-dd-num">2.</span>
						<span class="tinhdo-dd-text">Khuyên người niệm Phật</span>
					</a>
					<a href="{{ base_url }}/nhan-qua/bao-ung-hien-doi-tuyen-tap" class="tinhdo-top-dropdown-item" role="menuitem">
						<span class="tinhdo-dd-num">3.</span>
						<span class="tinhdo-dd-text">Báo Ứng Hiện Đời (BUHD)</span>
					</a>
					<a href="{{ base_url }}/phat-giao/kinh-phap-cu" class="tinhdo-top-dropdown-item" role="menuitem">
						<span class="tinhdo-dd-num">4.</span>
						<span class="tinhdo-dd-text">Kinh Pháp Cú</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="tinhdo-plaque-strip">
	<div class="tinhdo-plaque-strip-inner">
		<div class="plaque-line">
			<span class="plaque-label">Tâm Hạnh:</span>
			<span class="plaque-words">Chân thành <i class="lotus-dot">❖</i> Thanh tịnh <i class="lotus-dot">❖</i> Bình đẳng <i class="lotus-dot">❖</i> Chánh giác <i class="lotus-dot">❖</i> Từ bi</span>
		</div>
		<div class="plaque-divider-v" aria-hidden="true">|</div>
		<div class="plaque-line">
			<span class="plaque-label">Công Phu:</span>
			<span class="plaque-words">Nhìn thấu <i class="lotus-dot">❖</i> Buông xả <i class="lotus-dot">❖</i> Tự tại <i class="lotus-dot">❖</i> Tùy duyên <i class="lotus-dot">❖</i> Niệm Phật</span>
		</div>
	</div>
</div>
