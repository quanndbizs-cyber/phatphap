<div class="tm-breadcrumb-bar f6 pv1 w-100 flex-l justify-between items-center">

	<div class="tm-breadcrumb-trail">
		<a class="link f-link underline-hover tm-crumb-home" href="{{ base_url }}" title="{{ settings.title|e }}">🏠 Trang chủ</a>

		{% if settings.currentproject %}
			<span class="tm-crumb-sep" aria-hidden="true">&#x203A;</span>
			<a class="link f-link underline-hover" href="{{ base_url }}/{{ settings.currentproject }}">{{ settings.currentproject }}</a>
		{% endif %}

		{% for crumb in breadcrumb %}
			<span class="tm-crumb-sep" aria-hidden="true">&#x203A;</span>
			{% if loop.last %}
				<span class="tm-crumb-current">{{ crumb.name|e }}</span>
			{% else %}
				<a class="link f-link underline-hover" href="{{ crumb.urlRel }}">{{ crumb.name }}</a>
			{% endif %}
		{% endfor %}
	</div>
	<div class="dn dib-l tm-breadcrumb-Siblings">
		{% if item.prevItem %}
			<a class="link pr1 f-link underline-hover" href="{{ item.prevItem.urlRel }}">&lsaquo;&nbsp; {{ theme.previous|default('previous') }}</a>
		{% endif %}
		{% if item.nextItem %}
			<a class="link pl1 f-link underline-hover" href="{{ item.nextItem.urlRel }}">{{ theme.next|default('next') }} &nbsp;&rsaquo;</a>
		{% endif %}					
	</div>
</div>