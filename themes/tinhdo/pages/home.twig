{% set home = { 
	"landingpageIntro" : theme.introPosition|default('1'),
	"landingpageTinhDo" : theme.tinhdoPosition|default('1.5'),
	"landingpageInfo" : theme.infoPosition,
 	"landingpageTeaser" : theme.teaserPosition,
 	"landingpageContrast" : theme.contrastPosition,
 	"landingpageNavi" : theme.naviPosition,
 	"landingpageNews" : theme.newsPosition
	}
%}

{% for section,index in home|sort %}

	{% if index > 0 %}

		{% include 'home/' ~ section ~ '.twig' %}
	
	{% endif %}

{% endfor %}

{# Mobile navigation drawer for homepage #}
<aside class="grid-sidebar dn-l"> 
	<nav id="contentnav" class="contentnav{{ theme.collapseNav ? ' collapse' : '' }}" aria-label="Menu">
		<input type="checkbox" id="burger" class="dn">
		<label for="burger" class="burger-backdrop dn"></label>
		<label for="burger" class="burgerbutton" title="Chuyển bài / Mở Menu">&#9776;</label>	
		{% include 'partials/navigation.twig' %}
	</nav>
</aside>
