<main class="{{ item.elementType }} w-100 pb5 bl br bb">

	<div class="w-100 center grid-container">

		<aside class="grid-header ph3 pv3">

			<header>
						
				<div class="logo">
					<p class="pa0 ma0">
						<a class="link f1 fw9" href="{{ base_url }}" title="My Title">						
							{% if logo %}
								<img src="{{ base_url }}/{{ logo }}" class="logo-image"/>
							{% else %}
								{{ settings.title }}
							{% endif %}
						</a>
					</p>
				</div>
					
			</header>

			{% if widgets %}
				{% for index,widget in widgets %}
					<div id="{{ index }}" class="mt4-l mt3">
						{{ widget }}
					</div>
				{% endfor %}
			{% endif %}

		</aside>

		<div class="grid-main ph3 ph4-l pv3 lh-copy f4 fw3">

			{% if theme.blogintro %}
				<article>
					<header>
					
						<h1>{{ title|e }}</h1>

						<div class="tinhdo-reader-toolbar" aria-label="Thanh công cụ đọc sách">
							<div class="tinhdo-reader-tools">
								<span class="tinhdo-reader-tools-label"><i class="lotus-dot" aria-hidden="true">❖</i> Tiện ích đọc:</span>
								<div class="tinhdo-font-btn-group" role="group" aria-label="Tùy chỉnh cỡ chữ & hiển thị">
									{# 1 Button A+ chu kỳ tăng & reset #}
									<button type="button" class="tinhdo-reader-btn tm-font-cycle-btn" title="Tăng cỡ chữ (A+) — bấm để tăng, chạm mốc tối đa sẽ quay về 100%" aria-label="Tăng cỡ chữ">
										<span class="tm-font-cycle-label">A+</span>
										<span class="tm-font-scale-badge tm-font-scale-text">100%</span>
									</button>
									{# Chế độ đọc ban đêm (icon mặt trăng khuyết) #}
									<button type="button" class="tinhdo-reader-btn tm-night-mode-btn" title="Chế độ đọc ban đêm (dịu mắt, chống chói)" aria-label="Chế độ đọc ban đêm">
										<span class="tm-night-icon" aria-hidden="true">🌙</span>
									</button>
									{% if theme.elderlyModeSupport %}
									{# Chế độ Chữ Lớn Toàn Diện cho Người Cao Tuổi #}
									<button type="button" class="tinhdo-reader-btn tm-elderly-mode-btn" title="Bật/Tắt chế độ Chữ Lớn & Nút Bấm To Toàn Diện cho Người Cao Tuổi" aria-label="Chế độ chữ lớn người cao tuổi">
										<span class="tm-elderly-icon" aria-hidden="true">👓</span>
										<span class="tm-elderly-text">Chữ lớn</span>
									</button>
									{% endif %}
								</div>
							</div>
						</div>
		
					</header>

					{{ content }}

				</article>
			{% endif %}

			{% set pagelist = getPageList(navigation, theme.blogfolder, base_url) %}
			{% set pagesize = 10 %}
			{% set pages = ( pagelist.folderContent|length / pagesize)|round(0, 'ceil') %}
			{% set currentpage = currentpage ? currentpage : 1 %}
			{% set currentposts = (currentpage - 1) * pagesize %}

			{% if pagelist.contains == "posts" %}
				<ul class="post list pa0">

					{% for element in pagelist.folderContent|slice(currentposts, pagesize) %}

						{% set post = getPageMeta(settings, element) %}
						{% set date = element.order[0:4] ~ '-' ~ element.order[4:2] ~ '-' ~ element.order[6:2] %}

						<li class="post-entry">
							<header>
								{% if theme.blogimage and post.meta.heroimage != '' %}
									<figure>
										<img src="{{ assets.image(post.meta.heroimage).resize(820,500).src() }}"{% if post.meta.heroimagealt and post.meta.heroimagealt != '' %} alt="{{ post.meta.heroimagealt|e('html_attr') }}"{% endif %} />
									</figure>
								{% endif %}
								<a class="link f-link underline-hover" href="{{ element.urlRel }}"><h2 class="mt4 mb2">{{ post.meta.title|e }}</h2></a>
								<div class="mt3"><small><time datetime="{{date}}">{{ date | date("d.m.Y") }}</time> | {{ post.meta.author|e }}</small></div>
							</header>
							<p>{{ post.meta.description|e }}</p>
						</li>

					{% endfor %}

					{% if pages > 1 %}
						<hr class="mv4">
						<p>Page: 
							{% for i in 1 .. pages %}
								{% if i == currentpage %}
									{{i}}
								{% else %}
									<a class="page" href="{{ item.urlRel }}/p/{{i}}">{{i}}</a>
								{% endif %}
							{% endfor %}
						</p>
					{% endif %}

				</ul>
			{% else %}
				<p>The folder contains pages. To use the blog-feature on the startpage, please change the folder content to posts.</p>
			{% endif %}
		</div>

		<aside class="grid-sidebar ph3 pv3"> 

			<nav id="contentnav" class="contentnav{{ theme.collapseNav ? ' collapse' : '' }}" aria-label="Menu">

				<!-- burger menu controlled by invisible checkbox -->
	  			<input type="checkbox" id="burger" class="dn">
	  			<label for="burger" class="burger-backdrop dn"></label>
	  			<label for="burger" class="burgerbutton" title="Chuyển bài / Mở Menu">&#9776;</label>	

	  			{% if multilang %}
	  				<div class="flex dib w-100 mb2">
		  				{% include 'partials/languageswitch.twig' %}
		  			</div>
	  			{% endif %}

				{% include 'partials/navigation.twig' %}

			</nav>

		</aside>

	</div>

</main>