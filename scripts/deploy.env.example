# ==============================================================================
# CẤU HÌNH THIẾT LẬP TRIỂN KHAI (DEPLOY SETTINGS)
# File này chứa các biến cấu hình cho SSH, đường dẫn Web Root, và URL hệ thống.
# Bạn có thể chỉnh sửa các giá trị dưới đây tùy theo môi trường triển khai thực tế.
# Các biến môi trường truyền từ bên ngoài (nếu có) sẽ tự động được ưu tiên.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH KẾT NỐI SSH TỚI SERVER
# ------------------------------------------------------------------------------
# Địa chỉ IP hoặc tên miền máy chủ từ xa
SSH_HOST="${SSH_HOST:-192.168.1.22}"

# Cổng SSH (mặc định 22)
SSH_PORT="${SSH_PORT:-22}"

# Tài khoản SSH trên máy chủ từ xa
SSH_USER="${SSH_USER:-quannd}"

# Đường dẫn file SSH Private Key dùng để xác thực không cần mật khẩu
# (Hỗ trợ ký tự ~ đại diện cho thư mục HOME của user hiện tại)
SSH_KEY="${SSH_KEY:-~/.ssh/ssh_key/quannd_id_rsa}"


# ------------------------------------------------------------------------------
# 2. CẤU HÌNH ĐƯỜNG DẪN WEB ROOT
# ------------------------------------------------------------------------------
# Đường dẫn Web Root trên máy chủ Remote Server
REMOTE_WEB_ROOT="${REMOTE_WEB_ROOT:-/var/www/html/phatphap}"

# Đường dẫn Web Root tại máy Local (để trống để script tự động nhận diện theo thư mục cài đặt)
WEB_ROOT="${WEB_ROOT:-}"


# ------------------------------------------------------------------------------
# 3. CẤU HÌNH URL TRANG WEB (DÙNG CHO WARMUP CACHE & BỘ TEST KIT)
# ------------------------------------------------------------------------------
# URL website cục bộ dùng để warm-up navigation và chạy test stage
# (để trống để tự động nhận diện từ settings/settings.yaml hoặc http://localhost/phatphap)
WEB_URL="${WEB_URL:-http://localhost/phatphap}"
