# Auto detect text files and perform LF normalization on checkout
* text=auto

# Shell scripts must always use LF
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.php text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.twig text eol=lf
*.css text eol=lf
*.js text eol=lf
